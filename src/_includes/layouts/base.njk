<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#c0392b">
  <link rel="stylesheet" href="/style/main.css">
</head>
<body>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="{{ site.title }} home">
      <svg class="brand-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 17h18M5 17V9l4-4h6l4 4v8M9 17v-4h6v4"/>
      </svg>
      <span class="brand-name">{{ site.title }}</span>
    </a>

    <a href="https://github.com/hon1nbo/kei-fire-trucks" class="contribute-link" target="_blank" rel="noopener" aria-label="Contribute on GitHub">
      <svg class="contribute-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span class="contribute-label">Contribute</span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Toggle navigation">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <nav class="site-nav" id="nav-menu" aria-label="Main navigation">
      <ul class="nav-list" role="list">
        {% for item in navigation.items %}
          {% set isActive = page.url == item.url or (item.url != '/' and page.url | startsWith(item.url)) %}
          <li class="nav-item{% if item.children %} has-dropdown{% endif %}">
            <a href="{{ item.url }}" class="nav-link{% if isActive %} active{% endif %}"
               {% if item.children %}aria-haspopup="true"{% endif %}>
              {{ item.label }}{% if item.children %}<span class="dropdown-caret" aria-hidden="true"></span>{% endif %}
            </a>
            {% if item.children %}
            <ul class="nav-dropdown" role="list">
              {% for child in item.children %}
                <li>
                  <a href="{{ child.url }}" class="nav-dropdown-link{% if page.url == child.url %} active{% endif %}">
                    {{ child.label }}
                  </a>
                </li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

<main class="site-main" id="main-content">
  {{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-copy">&copy; {{ site.title }}</p>
    <p class="footer-license">
      Media: <a href="/licenses/" class="footer-link">CC BY-NC-SA 4.0</a> &nbsp;&middot;&nbsp;
      Software: <a href="/licenses/" class="footer-link">AGPL-3.0</a>
    </p>
  </div>
</footer>

<script>
(function () {
  var toggle = document.getElementById('nav-toggle');
  var menu = document.getElementById('nav-menu');

  toggle.addEventListener('click', function () {
    var expanded = this.getAttribute('aria-expanded') === 'true';
    this.setAttribute('aria-expanded', String(!expanded));
    menu.classList.toggle('is-open');
  });

  // Close on outside click
  document.addEventListener('click', function (e) {
    if (!toggle.contains(e.target) && !menu.contains(e.target)) {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }
  });

  // Close on Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.remove('is-open');
    }
  });
}());
</script>
</body>
</html>
